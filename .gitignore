# Terraform / Openterraform working directories and state
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Plan files
*.tfplan
*.plan

# Variable files with secrets
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.ci

# Local backend config (contém nome de bucket — não commitar)
backend.local.hcl

# Local environment files
.env
.env.*
!.env.example

# Certificates and private keys generated locally
*.pem
*.key
*.p12
*.pfx
*.csr

# Project-specific sensitive bootstrap artifacts
bootstrap/vault-init.json
bootstrap/*.json

# Shell scripts may contain sensitive env vars filled in by operators — never commit with real values
# scripts/terraform_*.sh  ← uncomment these lines if you fill in the secrets directly in the scripts
# scripts/terraform_apply.sh
# scripts/terraform_destroy.sh
# scripts/terraform_plan.sh

# Python cache and virtual environments
__pycache__/
*.py[cod]
*.pyo
.python-version
.venv/
venv/
env/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db